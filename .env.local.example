# Copy this file to .env.local and fill in your Supabase project's values.
# Found in Supabase: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: error alerts. Leave blank to skip - the app works fine without it.
# Found in Sentry: Settings > Projects > (your project) > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Needed for adding and managing admin/scorer logins from the admin page.
# Found in Supabase: Project Settings > API > service_role (secret). Server
# only - never prefix it with NEXT_PUBLIC_, and never share it.
SUPABASE_SERVICE_ROLE_KEY=
